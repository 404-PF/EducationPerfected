{
  "schemaVersion": 2,
  "targets": [
    "windows-x64",
    "macos-arm64",
    "macos-x64",
    "linux-x64",
    "linux-arm64"
  ],
  "globalChecks": [
    "project-rights-owner-risk-decision",
    "browser-acquisition-policy",
    "dependency-notices",
    "artifact-integrity"
  ],
  "targetChecks": [
    "native-build",
    "browser-acquisition-launch",
    "native-credential-save-read-delete",
    "console-shutdown",
    "clean-machine-no-node",
    "signing-or-explicit-unsigned-policy"
  ],
  "acceptedStatus": "passed",
  "rejectedStatusExamples": [
    "skipped",
    "fixture-only",
    "not-run",
    "failed",
    "pending"
  ],
  "note": "A gate pass is evidence completeness, not permission to publish, merge, spend or change policy. The project-rights-owner-risk-decision records an owner decision, not third-party legal clearance. Browser binaries are not distributed. Evidence must match the exact source commit.",
  "distributionMode": "direct-google-download",
  "browserBundled": false
}
